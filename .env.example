# Luthia - Local Development Configuration
# Copy this to .env and adjust as needed

# API Server
PORT=8080
READ_TIMEOUT_SECONDS=10
WRITE_TIMEOUT_SECONDS=30
IDLE_TIMEOUT_SECONDS=60

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=luthia
DB_PASSWORD=luthia
DB_NAME=luthia

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Worker
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL=2
